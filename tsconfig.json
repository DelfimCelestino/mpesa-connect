{
     "compilerOptions": {
          "target": "es6",
          "module": "commonjs",
          "outDir": "./dist",
          "rootDir": "./src",
          "strict": true,
          "esModuleInterop": true,
          "allowJs": true,
          "types": [
               "node"
          ]
     },
     "include": [
          "src/**/*",
          "src/test.ts",
          "@types"
     ],
     "exclude": [
          "node_modules",
          "**/*.spec.ts"
     ]
}